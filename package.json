{
  "name": "designers-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run src/lib src/modules",
    "test:integration": "vitest run tests/integration",
    "test:api": "vitest run src/app/api",
    "test:components": "vitest run src/__tests__/components",
    "test:forms": "vitest run tests/forms",
    "test:snapshots": "vitest run tests/snapshots",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test tests/e2e/flows",
    "test:e2e:security": "playwright test tests/e2e/security",
    "test:e2e:errors": "playwright test tests/e2e/errors",
    "test:a11y": "playwright test tests/e2e/accessibility",
    "test:perf": "playwright test tests/e2e/accessibility --grep PERF",
    "test:visual": "playwright test tests/e2e/accessibility --grep VR",
    "test:rls": "supabase test db tests/schema.test.sql tests/01_posts_rls.sql tests/02_comments_rls.sql tests/03_votes_rls.sql tests/04_profiles_rls.sql tests/05_cross_table_rls.sql",
    "test:static": "node tests/scripts/run-static-analysis.mjs",
    "test:schema": "node tests/scripts/run-schema-tests.mjs",
    "test:build-ci": "bash tests/scripts/run-build-ci.sh",
    "test:all": "npm run test && npm run test:e2e && npm run test:rls",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "db:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1068.0",
    "@base-ui/react": "^1.4.1",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^6.19.3",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.108.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "gsap": "^3.15.0",
    "isomorphic-dompurify": "^3.17.0",
    "lucide-react": "^1.16.0",
    "next": "14.2.33",
    "next-themes": "^0.4.6",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.75.0",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^8",
    "eslint-config-next": "14.2.33",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "postcss": "^8",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "prisma": "^6.19.3",
    "prismock": "^1.35.4",
    "supabase": "^2.106.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "uuid": "^14.0.0",
    "vite": "^8.0.16",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  }
}
